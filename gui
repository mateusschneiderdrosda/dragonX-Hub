-- Sidebar: botões com linha lateral + glow
-- =========================
local function setActiveCategory(cat)
    activeCategory = cat
    for name, btn in pairs(buttons) do
        local active = (name == cat)
        local line = btn:FindFirstChild("ActiveLine")
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = active and Theme.purple or Theme.bgSurface})
        btn.Icon.ImageColor3 = active and Theme.gold or Theme.muted
        btn.Label.TextColor3 = active and Theme.text or Theme.muted
        if line then line.Visible = active end
    end
    for _, panel in ipairs(content:GetChildren()) do
        if panel:IsA("Frame") then
            local show = (panel.Name == cat)
            if show then
                panel.Visible = true; panel.BackgroundTransparency = 1
                tween(panel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
            else
                panel.Visible = false
            end
        end
    end
end

for _, cat in ipairs(categories) do
    local btn = mk("Frame", {Name = cat, BackgroundColor3 = Theme.bgSurface, Size = UDim2.new(1, -24, 0, 48)}, sidebar)
    round(btn, Radius.md); stroke(btn, Theme.purple, 1, 0.45)

    local activeLine = mk("Frame", {Name = "ActiveLine", BackgroundColor3 = Theme.emerald, Size = UDim2.new(0, 3, 1, 0), Position = UDim2.new(0, -3, 0, 0), Visible = false}, btn)
    round(activeLine, Radius.sm)

    local icon = mk("ImageLabel", {
        Name = "Icon", BackgroundTransparency = 1, Image = iconMap[cat] or iconMap["Main"],
        ImageColor3 = Theme.muted, Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(0, 10, 0, 12)
    }, btn)
    local label = mk("TextLabel", {
        Name = "Label", BackgroundTransparency = 1, Text = cat,
        Font = Enum.Font.Gotham, TextSize = 16, TextColor3 = Theme.muted,
        Position = UDim2.new(0, 44, 0, 12), Size = UDim2.new(1, -54, 0, 24), TextXAlignment = Enum.TextXAlignment.Left
    }, btn)
    btn.Icon = icon; btn.Label = label

    btn.MouseEnter:Connect(function()
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.bgSurface:Lerp(Theme.blue, 0.15)})
        tween(icon, TweenInfo.new(0.15), {Size = UDim2.new(0, 26, 0, 26)})
    end)
    btn.MouseLeave:Connect(function()
        local active = (activeCategory == cat)
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = active and Theme.purple or Theme.bgSurface})
        tween(icon, TweenInfo.new(0.15), {Size = UDim2.new(0, 24, 0, 24)})
    end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then setActiveCategory(cat) end
    end)

    buttons[cat] = btn
end
setActiveCategory("Main")

