-- DragonXT Hub v2 — GUI Premium
-- LocalScript em StarterPlayerScripts ou StarterGui

local TweenService = game:GetService("TweenService")
local player = game.Players.LocalPlayer

-- Função de tween
local function tween(obj, info, goal)
    TweenService:Create(obj, info, goal):Play()
end

-- ScreenGui
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "DragonXT_Hub"
gui.ResetOnSpawn = false

-- Janela principal
local window = Instance.new("Frame", gui)
window.Size = UDim2.new(0, 900, 0, 540)
window.Position = UDim2.new(0.5, -450, 0.5, -270)
window.BackgroundColor3 = Color3.fromRGB(18,20,28)
window.BorderSizePixel = 0
Instance.new("UICorner", window).CornerRadius = UDim.new(0,18)

-- Header
local header = Instance.new("Frame", window)
header.Size = UDim2.new(1,0,0,64)
header.BackgroundColor3 = Color3.fromRGB(24,26,36)
Instance.new("UICorner", header).CornerRadius = UDim.new(0,18)

local title = Instance.new("TextLabel", header)
title.Text = "DragonXT Hub"
title.Font = Enum.Font.GothamBold
title.TextSize = 22
title.TextColor3 = Color3.fromRGB(230,235,255)
title.Position = UDim2.new(0,68,0,10)
title.Size = UDim2.new(0,300,0,24)

local subtitle = Instance.new("TextLabel", header)
subtitle.Text = "Blox Fruits | Premium Edition"
subtitle.Font = Enum.Font.Gotham
subtitle.TextSize = 14
subtitle.TextColor3 = Color3.fromRGB(160,170,190)
subtitle.Position = UDim2.new(0,68,0,34)
subtitle.Size = UDim2.new(0,300,0,20)

-- Botões minimizar/fechar
local minimized = false
local minBtn = Instance.new("TextButton", header)
minBtn.Text = "—"
minBtn.Size = UDim2.new(0,32,0,32)
minBtn.Position = UDim2.new(1,-80,0,16)
minBtn.BackgroundColor3 = Color3.fromRGB(18,20,28)
Instance.new("UICorner", minBtn).CornerRadius = UDim.new(0,10)

local closeBtn = Instance.new("TextButton", header)
closeBtn.Text = "✕"
closeBtn.Size = UDim2.new(0,32,0,32)
closeBtn.Position = UDim2.new(1,-40,0,16)
closeBtn.BackgroundColor3 = Color3.fromRGB(18,20,28)
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,10)

-- Minimizar corrigido
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        for _, child in ipairs(window:GetChildren()) do
            if child ~= header then child.Visible = false end
        end
        tween(window, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0,900,0,64)
        })
    else
        for _, child in ipairs(window:GetChildren()) do
            child.Visible = true
        end
        tween(window, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0,900,0,540)
        })
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    tween(window, TweenInfo.new(0.25), {BackgroundTransparency = 1})
    task.wait(0.25)
    gui:Destroy()
end)

-- Sidebar
local sidebar = Instance.new("Frame", window)
sidebar.Size = UDim2.new(0,200,1,-64)
sidebar.Position = UDim2.new(0,0,0,64)
sidebar.BackgroundColor3 = Color3.fromRGB(24,26,36)
Instance.new("UICorner", sidebar).CornerRadius = UDim.new(0,18)

local categories = {"Main","Farm","Combat","Fruits","Items","Teleport","Store / Shop","Settings"}
local activeCategory = "Main"

-- Área de conteúdo
local content = Instance.new("Frame", window)
content.Size = UDim2.new(1,-220,1,-84)
content.Position = UDim2.new(0,210,0,74)
content.BackgroundTransparency = 1

-- Função para trocar categoria
local function setCategory(cat)
    activeCategory = cat
    for _, panel in ipairs(content:GetChildren()) do
        panel.Visible = (panel.Name == cat)
    end
end

-- Criar botões da sidebar
for _, cat in ipairs(categories) do
    local btn = Instance.new("TextButton", sidebar)
    btn.Text = cat
    btn.Size = UDim2.new(1,-24,0,44)
    btn.BackgroundColor3 = Color3.fromRGB(18,20,28)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,12)

    btn.MouseButton1Click:Connect(function()
        setCategory(cat)
        -- animação de destaque
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(122,62,240)})
    end)

    -- Painel de conteúdo
    local panel = Instance.new("Frame", content)
    panel.Name = cat
    panel.Size = UDim2.new(1,0,1,0)
    panel.Visible = (cat == "Main")
    panel.BackgroundColor3 = Color3.fromRGB(24,26,36)
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0,18)

    -- Exemplo de card
    local card = Instance.new("TextLabel", panel)
    card.Text = "Funções de " .. cat
    card.Size = UDim2.new(0,260,0,140)
    card.Position = UDim2.new(0,20,0,20)
    card.BackgroundColor3 = Color3.fromRGB(18,20,28)
    Instance.new("UICorner", card).CornerRadius = UDim.new(0,14)
end
