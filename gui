local function mk(tag, props, parent)
    local inst = Instance.new(tag)
    for k,v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end
local function round(obj, r) mk("UICorner", {CornerRadius = UDim.new(0, r)}, obj) end
local function stroke(obj, color, thickness, transparency)
    mk("UIStroke", {
        Color = color, Thickness = thickness or 1.5,
        Transparency = transparency or 0.35,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end
local function tween(obj, info, goal) TweenService:Create(obj, info, goal):Play() end

