        Position = UDim2.new(0, 44, 0, 10), Size = UDim2.new(1, -54, 0, 24), TextXAlignment = Enum.TextXAlignment.Left
    }, btn)
    btn.Icon = icon; btn.Label = label

    btn.MouseEnter:Connect(function()
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.bg2:Lerp(Colors.blue, 0.15)})
        tween(icon, TweenInfo.new(0.15), {Size = UDim2.new(0, 26, 0, 26)})
    end)
    btn.MouseLeave:Connect(function()
        local active = (activeCategory == cat)
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = active and Colors.purple or Colors.bg2})
        tween(icon, TweenInfo.new(0.15), {Size = UDim2.new(0, 24, 0, 24)})
    end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then setActiveCategory(cat) end
    end)

    buttons[cat] = btn
end
setActiveCategory("Main")

