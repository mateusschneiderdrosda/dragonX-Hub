-- =========================
-- Helpers
-- =========================
local function mk(tag, props, parent)
    local inst = Instance.new(tag)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function roundify(guiObject, radius)
    local c = mk("UICorner", {CornerRadius = UDim.new(0, radius or CornerRadius)}, guiObject)
    return c
end

local function softShadow(parent, sizeScale)
    local shadow = mk("ImageLabel", {
        Name = "SoftShadow",
        BackgroundTransparency = 1,
        Image = "rbxassetid://1316045217", -- blur circle
        ImageColor3 = Color3.fromRGB(0,0,0),
        ImageTransparency = ShadowTransparency,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(10,10,118,118),
        Size = UDim2.new(1, 20, 1, 20),
        Position = UDim2.new(0, -10, 0, -10),
        ZIndex = (parent.ZIndex or 1) - 1
    }, parent)
    return shadow
end

local function glowStroke(parent, color, thickness)
    local uiStroke = mk("UIStroke", {
        Color = color,
        Thickness = thickness or 1.5,
        Transparency = 0.35,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, parent)
    return uiStroke
end

local function tween(obj, info, goal)
    return TweenService:Create(obj, info, goal):Play()
end

