local function CreateSection(parent, title, color, icon)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(0, 355, 0, 440)
    card.BackgroundColor3 = Color3.fromRGB(18, 18, 23)
    card.Parent = parent
    
    local CardCorner = Instance.new("UICorner")
    CardCorner.CornerRadius = UDim.new(0, 14)
    CardCorner.Parent = card
    
    local CardStroke = Instance.new("UIStroke")
    CardStroke.Color = color or Color3.fromRGB(70, 200, 100)
    CardStroke.Thickness = 2
    CardStroke.Transparency = 0.6
    CardStroke.Parent = card
    
    local SectionHeader = Instance.new("Frame")
    SectionHeader.Size = UDim2.new(1, 0, 0, 50)
    SectionHeader.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    SectionHeader.Parent = card
    Instance.new("UICorner", SectionHeader).CornerRadius = UDim.new(0, 14)
    
    local HeaderGrad = Instance.new("UIGradient")
    HeaderGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color or Color3.fromRGB(70, 200, 100)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(22, 22, 30))
    }
    HeaderGrad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0.6),
        NumberSequenceKeypoint.new(1, 0)
    }
    HeaderGrad.Parent = SectionHeader
    
    local IconLabel = Instance.new("TextLabel")
    IconLabel.Size = UDim2.new(0, 40, 1, 0)
    IconLabel.Position = UDim2.new(0, 10, 0, 0)
    IconLabel.BackgroundTransparency = 1
    IconLabel.Text = icon or "⚙️"
    IconLabel.TextSize = 22
    IconLabel.Parent = SectionHeader
    
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -60, 1, 0)
    t.Position = UDim2.new(0, 50, 0, 0)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = Color3.fromRGB(255, 255, 255)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 19
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = SectionHeader
    
    -- Scroll para muitos toggles
    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Size = UDim2.new(1, 0, 1, -50)
    ScrollFrame.Position = UDim2.new(0, 0, 0, 50)
    ScrollFrame.BackgroundTransparency = 1
    ScrollFrame.BorderSizePixel = 0
    ScrollFrame.ScrollBarThickness = 4
    ScrollFrame.Parent = card
    
    return ScrollFrame
end

local function createToggle(parent, text, posY, onToggled)
    local h = 38
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, h)
    btn.Position = UDim2.new(0, 10, 0, 10 + posY * (h + 6))
    btn.Text = ""
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    btn.AutoButtonColor = false
    btn.Parent = parent
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(45, 45, 60)
    BtnStroke.Thickness = 1.5
    BtnStroke.Parent = btn
    
    local lab = Instance.new("TextLabel")
    lab.BackgroundTransparency = 1
    lab.Size = UDim2.new(0.65, 0, 1, 0)
    lab.Position = UDim2.new(0, 14, 0, 0)
    lab.Font = Enum.Font.GothamSemibold
    lab.Text = text
    lab.TextColor3 = Color3.fromRGB(230, 230, 240)
    lab.TextSize = 14
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.Parent = btn
    
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 50, 0, 26)
    sw.Position = UDim2.new(1, -60, 0.5, -13)
    sw.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    sw.Parent = btn
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    
    local SwStroke = Instance.new("UIStroke")
    SwStroke.Color = Color3.fromRGB(70, 170, 255)
    SwStroke.Thickness = 2
    SwStroke.Transparency = 0.4
    SwStroke.Parent = sw
    
    local ball = Instance.new("Frame")
    ball.Size = UDim2.new(0, 20, 0, 20)
    ball.Position = UDim2.new(0, 3, 0, 3)
    ball.BackgroundColor3 = Color3.fromRGB(140, 140, 150)
    ball.Parent = sw
    Instance.new("UICorner", ball).CornerRadius = UDim.new(1, 0)
    
    local toggled = false
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        }):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.2), {
            Thickness = 2
        }):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(25, 25, 32)
        }):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.2), {
            Thickness = 1.5
        }):Play()
    end)
    
    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        
        TweenService:Create(ball, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
            Position = toggled and UDim2.new(1, -23, 0, 3) or UDim2.new(0, 3, 0, 3),
            BackgroundColor3 = toggled and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(140, 140, 150)
        }):Play()
        
        TweenService:Create(sw, TweenInfo.new(0.2), {
            BackgroundColor3 = toggled and Color3.fromRGB(35, 90, 60) or Color3.fromRGB(40, 40, 50)
        }):Play()
        
        TweenService:Create(SwStroke, TweenInfo.new(0.2), {
            Color = toggled and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(70, 170, 255),
            Transparency = toggled and 0.2 or 0.4
        }):Play()
        
        TweenService:Create(btn, TweenInfo.new(0.1), {
            Size = UDim2.new(1, -18, 0, h)
        }):Play()
        wait(0.05)
        TweenService:Create(btn, TweenInfo.new(0.1), {
            Size = UDim2.new(1, -20, 0, h)
        }):Play()
        
        if onToggled then 
            onToggled(toggled) 
        end
    end)
    
    return btn
end

