local function createCard(parent, titleText, subtitleText)
    local card = mk("Frame", {BackgroundColor3 = Colors.bg2, BorderSizePixel = 0}, parent)
    roundify(card, 14)
    stroke(card, Colors.emerald, 1.2, 0.45)
    mk("UIPadding", {PaddingTop = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12)}, card)

    local title = mk("TextLabel", {
        BackgroundTransparency = 1, Text = titleText,
        Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Colors.text,
        Size = UDim2.new(1, -24, 0, 24), Position = UDim2.new(0, 0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)
    local subtitle = mk("TextLabel", {
        BackgroundTransparency = 1, Text = subtitleText or "",
        Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Colors.muted,
        Size = UDim2.new(1, -24, 0, 20), Position = UDim2.new(0, 0, 0, 26),
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)

    -- Hover suave
    card.MouseEnter:Connect(function()
        tween(card, TweenInfo.new(0.15), {BackgroundColor3 = Colors.bg2:Lerp(Colors.purple, 0.08)})
    end)
    card.MouseLeave:Connect(function()
        tween(card, TweenInfo.new(0.15), {BackgroundColor3 = Colors.bg2})
    end)

    return card
end

local function createToggle(parent, labelText, default)
    local holder = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 36), Position = UDim2.new(0, 0, 0, 54)}, parent)
    local label = mk("TextLabel", {
        BackgroundTransparency = 1, Text = labelText,
        Font = Enum.Font.Gotham, TextSize = 16, TextColor3 = Colors.text,
        Size = UDim2.new(1, -60, 1, 0), TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local toggle = mk("Frame", {BackgroundColor3 = Colors.bg2, Size = UDim2.new(0, 56, 0, 28), Position = UDim2.new(1, -60, 0.5, -14)}, holder)
    roundify(toggle, 14); stroke(toggle, Colors.blue, 1.2, 0.35)
    local knob = mk("Frame", {BackgroundColor3 = Colors.gold, Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(0, 2, 0, 2)}, toggle)
    roundify(knob, 12); stroke(knob, Colors.gold, 1, 0.2)

    local state = default or false
    local function apply(animated)
        local goalPos = state and UDim2.new(0, 30, 0, 2) or UDim2.new(0, 2, 0, 2)
        local goalColor = state and Colors.emerald or Colors.bg2
        if animated then
            tween(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goalPos})
            tween(toggle, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = goalColor})
        else
            knob.Position = goalPos; toggle.BackgroundColor3 = goalColor
        end
    end
    apply(false)

    toggle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            state = not state; apply(true)
        end
    end)

    return {Holder = holder, Toggle = toggle, Get = function() return state end, Set = function(v) state = v; apply(true) end}
end

local function createSlider(parent, labelText, min, max, default, onChanged)
    local holder = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 60), Position = UDim2.new(0, 0, 0, 96)}, parent)
    local label = mk("TextLabel", {
        BackgroundTransparency = 1, Text = labelText,
        Font = Enum.Font.Gotham, TextSize = 16, TextColor3 = Colors.text,
        Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local bar = mk("Frame", {BackgroundColor3 = Colors.bg2, Size = UDim2.new(1, -10, 0, 8), Position = UDim2.new(0, 0, 0, 28)}, holder)
    roundify(bar, 4); stroke(bar, Colors.purple, 1, 0.35)
    local fill = mk("Frame", {BackgroundColor3 = Colors.purple, Size = UDim2.new(0, 0, 1, 0)}, bar); roundify(fill, 4)
    local knob = mk("Frame", {BackgroundColor3 = Colors.gold, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 0, 0.5, -8)}, bar)
    roundify(knob, 8); stroke(knob, Colors.gold, 1, 0.2)
    local valueLabel = mk("TextLabel", {
        BackgroundTransparency = 1, Text = tostring(default or min),
        Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Colors.muted,
        Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -60, 0, 0), TextXAlignment = Enum.TextXAlignment.Right
    }, holder)

    local value = math.clamp(default or min, min, max)
    local function visuals(animated)
        local pct = (value - min) / (max - min)
        valueLabel.Text = tostring(math.floor(value))
        local goalFill = UDim2.new(pct, 0, 1, 0)
        local goalKnob = UDim2.new(pct, -8, 0.5, -8)
        if animated then
            tween(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = goalFill})
            tween(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goalKnob})
        else
            fill.Size = goalFill; knob.Position = goalKnob
        end
    end
    visuals(false)

    local dragging = false
    bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    bar.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            value = math.clamp(min + rel * (max - min), min, max)
            visuals(true); if onChanged then onChanged(value) end
        end
    end)

    return {Holder = holder, Get = function() return value end, Set = function(v) value = math.clamp(v, min, max); visuals(true); if onChanged then onChanged(value) end end}
end

local function createButton(parent, text, accentColor, callback)
    local btn = mk("TextButton", {
        Text = text, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Colors.text,
        BackgroundColor3 = Colors.bg2, Size = UDim2.new(0, 220, 0, 36)
    }, parent)
    roundify(btn, 10); stroke(btn, accentColor, 2, 0.35)
    btn.MouseEnter:Connect(function()
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = accentColor})
        btn.TextColor3 = Color3.fromRGB(10,10,10)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.bg2})
        btn.TextColor3 = Colors.text
    end)
    btn.MouseButton1Click:Connect(function()
        tween(btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 214, 0, 34)})
        task.delay(0.09, function() tween(btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 220, 0, 36)}) end)
        if callback then callback() end
    end)
    return btn
end

