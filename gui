local function createToggle(parent, labelText, default)
    local holder = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 38), Position = UDim2.new(0, 0, 0, 74)}, parent)
    local label = mk("TextLabel", {
        BackgroundTransparency = 1, Text = labelText,
        Font = Enum.Font.Gotham, TextSize = 16, TextColor3 = Theme.text,
        Size = UDim2.new(1, -80, 1, 0), TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local toggle = mk("Frame", {BackgroundColor3 = Theme.bgSurface, Size = UDim2.new(0, 64, 0, 28), Position = UDim2.new(1, -64, 0.5, -14)}, holder)
    round(toggle, Radius.md); stroke(toggle, Theme.blue, 1.2, 0.35)
    mk("UIGradient", {Color = ColorSequence.new(Theme.bgSurface, Theme.emerald), Transparency = NumberSequence.new(0.6)}, toggle)

    local knob = mk("Frame", {BackgroundColor3 = Theme.gold, Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(0, 2, 0, 2)}, toggle)
    round(knob, Radius.sm); stroke(knob, Theme.gold, 1, 0.2)

    local state = default or false
    local function apply(animated)
        local goalPos = state and UDim2.new(0, 38, 0, 2) or UDim2.new(0, 2, 0, 2)
        local goalColor = state and Theme.emerald or Theme.bgSurface
        if animated then
            tween(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goalPos})
            tween(toggle, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = goalColor})
        else
            knob.Position = goalPos; toggle.BackgroundColor3 = goalColor
        end
    end
    apply(false)

    toggle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then state = not state; apply(true) end
    end)

    return {Holder = holder, Toggle = toggle, Get = function() return state end, Set = function(v) state = v; apply(true) end}
end

local function createSlider(parent, labelText, min, max, default, onChanged)
    local holder = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 76), Position = UDim2.new(0, 0, 0, 120)}, parent)
    local label = mk("TextLabel", {
        BackgroundTransparency = 1, Text = labelText,
        Font = Enum.Font.Gotham, TextSize = 16, TextColor3 = Theme.text,
        Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local bar = mk("Frame", {BackgroundColor3 = Theme.bgSurface, Size = UDim2.new(1, -10, 0, 10), Position = UDim2.new(0, 0, 0, 32)}, holder)
    round(bar, Radius.sm); stroke(bar, Theme.purple, 1, 0.35)
    mk("UIGradient", {Color = ColorSequence.new(Theme.purple, Theme.blue), Transparency = NumberSequence.new(0.2)}, bar)

    local fill = mk("Frame", {BackgroundColor3 = Theme.purple, Size = UDim2.new(0, 0, 1, 0)}, bar); round(fill, Radius.sm)
    local knob = mk("Frame", {BackgroundColor3 = Theme.gold, Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 0, 0.5, -9)}, bar)
    round(knob, Radius.sm); stroke(knob, Theme.gold, 1, 0.2)

    local valueLabel = mk("TextLabel", {
        BackgroundTransparency = 1, Text = tostring(default or min),
        Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.text,
        Size = UDim2.new(0, 70, 0, 20), Position = UDim2.new(1, -70, 0, 0), TextXAlignment = Enum.TextXAlignment.Right
    }, holder)

    local value = math.clamp(default or min, min, max)
    local function visuals(animated)
        local pct = (value - min) / (max - min)
        valueLabel.Text = tostring(math.floor(value))
        local goalFill = UDim2.new(pct, 0, 1, 0)
        local goalKnob = UDim2.new(pct, -9, 0.5, -9)
        if animated then
            tween(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = goalFill})
            tween(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goalKnob})
        else
            fill.Size = goalFill; knob.Position = goalKnob
        end
    end
    visuals(false)

    local dragging = false
    bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    bar.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            value = math.clamp(min + rel * (max - min), min, max)
            visuals(true); if onChanged then onChanged(value) end
        end
    end)

    return {Holder = holder, Get = function() return value end, Set = function(v) value = math.clamp(v, min, max); visuals(true); if onChanged then onChanged(value) end end}
end

