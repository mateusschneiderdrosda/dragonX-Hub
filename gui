local function setActiveCategory(cat)
    activeCategory = cat
    for name, btn in pairs(buttons) do
        local active = (name == cat)
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = active and Colors.purple or Colors.bg2})
        btn.Icon.ImageColor3 = active and Colors.gold or Colors.muted
        btn.Label.TextColor3 = active and Colors.text or Colors.muted
    end
    for _, panel in ipairs(content:GetChildren()) do
        if panel:IsA("Frame") then
            local show = (panel.Name == cat)
            if show then
                panel.Visible = true; panel.BackgroundTransparency = 1
                tween(panel, TweenInfo.new(0.2), {BackgroundTransparency = 0})
            else
                panel.Visible = false
            end
        end
    end
end

