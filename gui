local function setActiveCategory(cat)
    activeCategory = cat
    for name, btn in pairs(buttons) do
        local isActive = (name == cat)
        tween(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = isActive and Colors.accentPurple or Colors.bg2
        })
        btn.Icon.ImageColor3 = isActive and Colors.accentGold or Colors.textMuted
        btn.Label.TextColor3 = isActive and Colors.textPrimary or Colors.textMuted
        btn.Glow.Enabled = isActive
    end
end

